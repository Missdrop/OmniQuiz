#!/usr/bin/env bash
set -euo pipefail
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "$PROJECT_ROOT/.tooling"
if [[ ! -x "$PROJECT_ROOT/.tooling/flutter/bin/flutter" ]]; then
  git clone --depth 1 --branch 3.47.7 https://github.com/flutter/flutter.git "$PROJECT_ROOT/.tooling/flutter"
fi
cd "$PROJECT_ROOT"
./scripts/flutter pub get
